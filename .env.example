# Django
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.production

# Database (Docker Compose usa estos valores — ver docker-compose.yml environment)
DATABASE_NAME=notifier
DATABASE_USER=postgres
DATABASE_PASSWD=postgres
DATABASE_HOST=db
DATABASE_PORT=5432

# Redis (Docker)
REDIS_URL=redis://redis:6379/0

# Fernet encryption key para configuraciones de proveedores
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-fernet-key-here

# CORS / CSRF
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Sentry (opcional)
SENTRY_DSN=
