{
  "info": {
    "name": "Notifier Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección completa de la API de Notifier Platform v2. Canales: EMAIL, SMS, WHATSAPP, PUSH, WEBSOCKET."
  },
  "variable": [
    { "key": "base_url",        "value": "http://localhost:8000", "type": "string" },
    { "key": "api_key",         "value": "ntf_TU_API_KEY_AQUI",  "type": "string" },
    { "key": "notification_id", "value": "",                      "type": "string" },
    { "key": "template_id",     "value": "",                      "type": "string" },
    { "key": "provider_id",     "value": "",                      "type": "string" },
    { "key": "api_key_id",      "value": "",                      "type": "string" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key",   "value": "Authorization",      "type": "string" },
      { "key": "value", "value": "Api-Key {{api_key}}", "type": "string" },
      { "key": "in",    "value": "header",              "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Auth — API Keys",
      "item": [
        {
          "name": "Listar API Keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/api-keys/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "api-keys", ""]
            },
            "description": "Devuelve todas las API Keys activas de la organización autenticada."
          }
        },
        {
          "name": "Crear API Key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('api_key_id', json.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Producción\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/api-keys/create/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "api-keys", "create", ""]
            },
            "description": "Genera una nueva API Key. La clave completa (ntf_...) solo se devuelve aquí."
          }
        },
        {
          "name": "Revocar API Key",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/api-keys/{{api_key_id}}/revoke/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "api-keys", "{{api_key_id}}", "revoke", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Listar notificaciones",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/notifications/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications", ""],
              "query": [
                {
                  "key": "status",
                  "value": "COMPLETED",
                  "description": "QUEUED | PROCESSING | COMPLETED | FAILED | PARTIALLY_FAILED | CANCELLED",
                  "disabled": true
                }
              ]
            }
          }
        },
        {
          "name": "Enviar — EMAIL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('notification_id', json.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Bienvenido a Notifier\",\n  \"message\": \"<h1>Hola Juan</h1><p>Tu cuenta ha sido activada.</p>\",\n  \"priority\": \"HIGH\",\n  \"channels\": [\"EMAIL\"],\n  \"recipients\": [\n    {\n      \"name\": \"Juan Pérez\",\n      \"email\": \"juan@ejemplo.com\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/notifications/send/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications", "send", ""]
            }
          }
        },
        {
          "name": "Enviar — SMS",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('notification_id', json.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Código de verificación\",\n  \"message\": \"Tu código de verificación es: 482910. Válido por 5 minutos.\",\n  \"priority\": \"CRITICAL\",\n  \"channels\": [\"SMS\"],\n  \"recipients\": [\n    {\n      \"name\": \"Juan Pérez\",\n      \"phone\": \"+573001234567\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/notifications/send/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications", "send", ""]
            },
            "description": "El campo phone debe incluir el código de país: +57 para Colombia, +1 para USA, etc."
          }
        },
        {
          "name": "Enviar — WhatsApp",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('notification_id', json.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Recordatorio de cita\",\n  \"message\": \"Hola Juan 👋 Te recordamos que tienes una cita mañana a las 10:00 AM. Responde SI para confirmar o NO para cancelar.\",\n  \"priority\": \"HIGH\",\n  \"channels\": [\"WHATSAPP\"],\n  \"recipients\": [\n    {\n      \"name\": \"Juan Pérez\",\n      \"phone\": \"+573001234567\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/notifications/send/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications", "send", ""]
            },
            "description": "Requiere número aprobado en Twilio WhatsApp Sandbox o cuenta Business verificada."
          }
        },
        {
          "name": "Enviar — Push (FCM)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('notification_id', json.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Nuevo mensaje\",\n  \"message\": \"Tienes un nuevo mensaje de soporte.\",\n  \"priority\": \"HIGH\",\n  \"channels\": [\"PUSH\"],\n  \"metadata\": {\n    \"screen\": \"support\",\n    \"ticket_id\": \"12345\"\n  },\n  \"recipients\": [\n    {\n      \"name\": \"Juan Pérez\",\n      \"push_token\": \"fcm_device_token_del_dispositivo\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/notifications/send/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications", "send", ""]
            },
            "description": "push_token es el FCM registration token del dispositivo. El campo metadata se envía como data payload a la app."
          }
        },
        {
          "name": "Enviar — Multi-canal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('notification_id', json.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Alerta de seguridad\",\n  \"message\": \"Se detectó un inicio de sesión desde una nueva ubicación.\",\n  \"priority\": \"CRITICAL\",\n  \"channels\": [\"EMAIL\", \"SMS\", \"PUSH\"],\n  \"recipients\": [\n    {\n      \"name\": \"Juan Pérez\",\n      \"email\": \"juan@ejemplo.com\",\n      \"phone\": \"+573001234567\",\n      \"push_token\": \"fcm_device_token_del_dispositivo\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/notifications/send/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications", "send", ""]
            },
            "description": "Envía por varios canales simultáneamente. Cada canal crea su propio DeliveryAttempt."
          }
        },
        {
          "name": "Enviar — Con plantilla",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Factura generada\",\n  \"template_id\": \"{{template_id}}\",\n  \"template_variables\": {\n    \"name\": \"Juan Pérez\",\n    \"amount\": \"$1,500.00\",\n    \"due_date\": \"2026-09-01\"\n  },\n  \"priority\": \"NORMAL\",\n  \"channels\": [\"EMAIL\"],\n  \"recipients\": [\n    { \"name\": \"Juan Pérez\",  \"email\": \"juan@ejemplo.com\" },\n    { \"name\": \"María López\", \"email\": \"maria@ejemplo.com\" }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/notifications/send/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications", "send", ""]
            }
          }
        },
        {
          "name": "Enviar — Programada",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Recordatorio de pago\",\n  \"message\": \"Tu factura vence mañana. Evita cargos por mora.\",\n  \"priority\": \"HIGH\",\n  \"channels\": [\"EMAIL\", \"SMS\"],\n  \"scheduled_at\": \"2026-08-10T09:00:00Z\",\n  \"recipients\": [\n    {\n      \"name\": \"Juan Pérez\",\n      \"email\": \"juan@ejemplo.com\",\n      \"phone\": \"+573001234567\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/notifications/send/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications", "send", ""]
            }
          }
        },
        {
          "name": "Detalle de notificación",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/notifications/{{notification_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications", "{{notification_id}}", ""]
            },
            "description": "Muestra la notificación con todos los DeliveryAttempts por destinatario y canal."
          }
        },
        {
          "name": "Reintentar notificación fallida",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/notifications/{{notification_id}}/retry/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications", "{{notification_id}}", "retry", ""]
            },
            "description": "Solo funciona si el estado es FAILED o PARTIALLY_FAILED."
          }
        },
        {
          "name": "Cancelar notificación",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/notifications/{{notification_id}}/cancel/",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notifications", "{{notification_id}}", "cancel", ""]
            },
            "description": "Solo funciona si el estado es QUEUED (aún no procesada)."
          }
        }
      ]
    },
    {
      "name": "Providers",
